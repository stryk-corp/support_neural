# Required only for answer generation. Reindexing never calls Gemini.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
GEMINI_DAILY_CALL_LIMIT=200
ANSWER_CACHE_TTL_SECONDS=86400
SENTRY_DSN=

# Comma-separated exact browser origins. Origin checks are not a substitute for rate limits.
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:9002,http://127.0.0.1:8080,http://localhost:8080
MAX_CHAT_INPUT_CHARS=2000
MAX_REQUESTS_PER_MINUTE=30

# Use a long random value. Admin endpoints are hidden when this is blank.
SUPPORTBOT_ADMIN_TOKEN=
SUPPORTBOT_DB=supportbot/var/supportbot.sqlite3
KB_PATH=u.json
APPROVED_PATHS_PATH=supportbot/approved_paths.json

# Local development can leave DATABASE_URL blank and use SQLite FTS.
# Hosted deployment should set DATABASE_URL to one PostgreSQL database with pgvector enabled.
DATABASE_URL=
LADI_TENANT_ID=neuralvillage
DEFAULT_KB_SCOPE=public
EMBEDDING_MODEL=intfloat/multilingual-e5-small

# Optional JSON maps. Unmapped integrations only receive the public scope.
# WEB_SCOPE_MAP: {"https://site.example":{"tenant_id":"neuralvillage","scope_id":"public"}}
# CHANNEL_SCOPE_MAP: {"whatsapp:PHONE_ID":{"tenant_id":"neuralvillage","scope_id":"wa:group-a"}}
WEB_SCOPE_MAP={}
CHANNEL_SCOPE_MAP={}

# Meta webhooks (optional). Use the same Meta app settings for subscribed channels.
META_APP_SECRET=
META_VERIFY_TOKEN=
META_ACCESS_TOKEN=
META_GRAPH_VERSION=v24.0
WHATSAPP_PHONE_NUMBER_ID=
MESSENGER_PAGE_ID=
INSTAGRAM_USER_ID=